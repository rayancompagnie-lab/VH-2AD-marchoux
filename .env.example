# Copie ce fichier en ".env" et remplis avec tes propres clés.
# Ne jamais committer le fichier ".env" (déjà exclu dans .gitignore).

# --- Firebase (Project settings > General > Your apps > SDK setup) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Agora (pour le "direct" audio) ---
# Crée un compte gratuit sur https://console.agora.io
# Récupère l'App ID dans Project Management
VITE_AGORA_APP_ID=b7bd4dcd913d4edc926ef8bf55a0159e

# Certificat Agora (SECRET — jamais préfixé VITE_, jamais exposé au navigateur).
# Utilisé uniquement par la fonction serveur /api/agora-token.js.
# En local, cette fonction ne s'exécute pas avec `npm run dev` (seulement sur Vercel
# ou via `vercel dev`), donc le direct ne fonctionnera qu'une fois déployé.
AGORA_APP_CERTIFICATE=b28764fd8aa44f74b0f6fd7d46d8e8db
