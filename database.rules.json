{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "role": {
          ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "premium": {
          ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "secteurs": {
          ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "badges": {
          ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'semiAdmin'"
        }
      }
    },

    "badges": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'semiAdmin')"
    },

    "posts": {
      "culte": {
        ".read": "auth != null",
        "$postId": {
          ".write": "auth != null && (!data.exists() ? (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('secteurs').child('actualites').val() === true) : (data.child('authorUid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('secteurs').child('actualites').val() === true))",
          "reactions": {
            "$emoji": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid"
              }
            }
          }
        }
      },
      "travail": {
        ".read": "auth != null",
        "$postId": {
          ".write": "auth != null && (!data.exists() ? (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('secteurs').child('infosTravail').val() === true) : (data.child('authorUid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('secteurs').child('infosTravail').val() === true))",
          "reactions": {
            "$emoji": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid"
              }
            }
          }
        }
      }
    },

    "liveSessions": {
      ".read": "auth != null",
      "current": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "marche": {
      ".read": "auth != null",
      "$articleId": {
        ".write": "auth != null && (!data.exists() || data.child('authorUid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('secteurs').child('marche').val() === true)"
      }
    },

    "temoignages": {
      ".read": "auth != null",
      "$temoignageId": {
        ".write": "auth != null && (!data.exists() || data.child('authorUid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('secteurs').child('temoignages').val() === true)"
      }
    },

    "groupes": {
      "$groupPath": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || ($groupPath.beginsWith('tribu-') && root.child('users').child(auth.uid).child('tribu').val() === $groupPath.replace('tribu-', '')) || ($groupPath.beginsWith('statut-') && root.child('users').child(auth.uid).child('statutRelationnel').val() === $groupPath.replace('statut-', '')) || ($groupPath.beginsWith('badge-') && root.child('users').child(auth.uid).child('badges').child($groupPath.replace('badge-', '')).val() === true))",
        "$postId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || data.child('authorUid').val() === auth.uid || (!data.exists() && (($groupPath.beginsWith('tribu-') && root.child('users').child(auth.uid).child('tribu').val() === $groupPath.replace('tribu-', '')) || ($groupPath.beginsWith('statut-') && root.child('users').child(auth.uid).child('statutRelationnel').val() === $groupPath.replace('statut-', '')) || ($groupPath.beginsWith('badge-') && root.child('users').child(auth.uid).child('badges').child($groupPath.replace('badge-', '')).val() === true))))"
        }
      }
    }
  }
}
