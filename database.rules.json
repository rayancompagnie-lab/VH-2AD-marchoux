{
  "rules": {
    "admins": {
      ".read": "auth != null",
      ".write": false,
      "$uid": {
        ".validate": "newData.isBoolean() || newData.val() === null"
      }
    },

    "config": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "badges": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$badgeId": {
        ".validate": "newData.hasChildren(['name', 'colors'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "colors": { ".validate": "newData.isString() || newData.hasChildren()" }
      }
    },

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['nom', 'prenom', 'email'])",
        "nom": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "prenom": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "email": { ".validate": "newData.isString() && newData.val().matches(/^[^@]+@[^@]+\\.[^@]+$/)" },
        "sexe": { ".validate": "newData.val() === 'homme' || newData.val() === 'femme' || newData.val() === ''" },
        "contact": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "titre": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "experience": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "lieuHabitation": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "service": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "serviceVisible": { ".validate": "newData.isBoolean()" },
        "tribu": { ".validate": "newData.isString()" },
        "statutRelationnel": { ".validate": "newData.isString()" },
        "photoPrincipale": { ".validate": "newData.isString()" },
        "photoSecondaire": { ".validate": "newData.isString()" },
        "role": { ".validate": "newData.val() === 'member' || newData.val() === 'semiAdmin' || newData.val() === 'admin'" },
        "premium": { ".validate": "newData.isBoolean()" },
        "profileComplete": { ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isNumber() || newData.val() === null" },
        "$other": { ".validate": false }
      }
    },

    "posts": {
      ".read": "auth != null",
      "culte": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('secteurs').child('actualites').val() === true)",
        "$postId": {
          ".validate": "newData.hasChildren(['authorUid', 'createdAt', 'expiresAt', 'type'])"
        }
      },
      "travail": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('secteurs').child('infosTravail').val() === true)",
        "$postId": {
          ".validate": "newData.hasChildren(['authorUid', 'createdAt', 'expiresAt', 'type'])"
        }
      }
    },

    "groupes": {
      ".read": "auth != null",
      "$groupPath": {
        ".write": "auth != null",
        "$postId": {
          ".validate": "newData.hasChildren(['authorUid', 'createdAt', 'expiresAt', 'content'])"
        }
      }
    },

    "temoignages": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren(['authorUid', 'approved', 'createdAt', 'type'])",
        "approved": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('secteurs').child('temoignages').val() === true)"
        }
      }
    },

    "marche": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$articleId": {
        ".validate": "newData.hasChildren(['authorUid', 'titre', 'description', 'createdAt'])"
      }
    },

    "attendance": {
      ".read": "auth != null",
      "$date": {
        "$culteKey": {
          "$tribu": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('tribu').val() === $tribu)"
            }
          },
          "closed": {
            ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
          }
        }
      }
    },

    "liveSessions": {
      ".read": "auth != null",
      "current": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        "listeners": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
          }
        }
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}