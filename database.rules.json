{
  "rules": {
    "config": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "tribus": {
      ".read": "auth != null",
      "$tribuKey": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "patriarcheUid": {
          ".validate": "newData.isString() || newData.val() === null"
        },
        "$other": { ".validate": false }
      }
    },

    "cultes": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$culteId": {
        ".validate": "newData.hasChildren(['theme', 'date', 'type', 'createdBy', 'createdAt'])",
        "theme":  { ".validate": "newData.isString() && newData.val().length <= 100" },
        "date":   { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
        "heure":  { ".validate": "newData.isString() && newData.val().length <= 5" },
        "type":   { ".validate": "newData.val() === 'dimanche' || newData.val() === 'mercredi' || newData.val() === 'special'" },
        "closed": { ".validate": "newData.isBoolean() || newData.val() === null" },
        "createdBy": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "delegatedMembers": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (newData.child('createdBy').val() === auth.uid || root.child('tribus').child(newData.child('tribu').val()).child('patriarcheUid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['nom', 'prenom', 'sexe', 'avatarId', 'tribu', 'estDelegue', 'createdBy', 'createdAt'])",
        "nom":    { ".validate": "newData.isString() && newData.val().length <= 50" },
        "prenom": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "sexe":   { ".validate": "newData.val() === 'homme' || newData.val() === 'femme'" },
        "avatarId": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "tribu":  { ".validate": "newData.isString()" },
        "contact": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "lieuHabitation": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "estDelegue": { ".validate": "newData.val() === true" },
        "createdBy": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['nom', 'prenom', 'email'])",
        "nom": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "prenom": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "email": { ".validate": "newData.isString() && newData.val().matches(/^[^@]+@[^@]+\\.[^@]+$/)" },
        "sexe": { ".validate": "newData.val() === 'homme' || newData.val() === 'femme' || newData.val() === ''" },
        "avatarId": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "contact": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "titre": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "experience": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "lieuHabitation": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "service": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "serviceVisible": { ".validate": "newData.isBoolean()" },
        "tribu": { ".validate": "newData.isString()" },
        "statutRelationnel": { ".validate": "newData.isString()" },
        "role": { ".validate": "newData.val() === 'member' || newData.val() === 'semiAdmin' || newData.val() === 'admin'" },
        "premium": { ".validate": "newData.isBoolean()" },
        "profileComplete": { ".validate": "newData.isBoolean()" },
        "biblePlan": {
          ".validate": "newData.hasChildren(['bookCode', 'nbJours', 'startDate'])",
          "bookCode": { ".validate": "newData.isString()" },
          "bookLabel": { ".validate": "newData.isString()" },
          "nbJours": { ".validate": "newData.isNumber()" },
          "startDate": { ".validate": "newData.isString()" },
          "completedDays": { ".validate": "newData.hasChildren() || newData.val() === null" },
          "createdAt": { ".validate": "newData.isNumber()" }
        },
        "createdAt": { ".validate": "newData.isNumber() || newData.val() === null" },
        "badges": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          "$badgeId": { ".validate": "newData.isBoolean() || newData.val() === null" }
        },
        "secteurs": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          "$secteurKey": { ".validate": "newData.isBoolean() || newData.val() === null" }
        },
        "$other": { ".validate": false }
      }
    },

    "posts": {
      ".read": "auth != null",
      "culte": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('secteurs').child('actualites').val() === true)",
        "$postId": {
          ".validate": "newData.hasChildren(['authorUid', 'createdAt', 'expiresAt', 'type'])"
        }
      },
      "travail": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('secteurs').child('infosTravail').val() === true)",
        "$postId": {
          ".validate": "newData.hasChildren(['authorUid', 'createdAt', 'expiresAt', 'type'])"
        }
      }
    },

    "groupes": {
      ".read": "auth != null",
      "$groupPath": {
        ".write": "auth != null",
        "$postId": {
          ".validate": "newData.hasChildren(['authorUid', 'createdAt', 'expiresAt', 'content'])"
        }
      }
    },

    "temoignages": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren(['authorUid', 'approved', 'createdAt', 'type'])",
        "approved": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('secteurs').child('temoignages').val() === true)"
        }
      }
    },

    "marche": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$articleId": {
        ".validate": "newData.hasChildren(['authorUid', 'titre', 'description', 'createdAt'])",
        "images": {
          ".validate": "newData.isString() || newData.hasChildren() || newData.val() === null"
        }
      }
    },

    "attendance": {
      ".read": "auth != null",
      "$date": {
        "$culteId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('tribus').child($tribu).child('patriarcheUid').val() === auth.uid && root.child('cultes').child($culteId).child('closed').val() !== true))",
          "closed": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('tribus').child($tribu).child('patriarcheUid').val() === auth.uid)"
          },
          "$tribu": {
            "$uid": {
              ".validate": "newData.hasChildren(['uid', 'name', 'status', 'markedBy', 'markedAt'])",
              "status": { ".validate": "newData.val() === 'present' || newData.val() === 'absent'" }
            }
          }
        }
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
