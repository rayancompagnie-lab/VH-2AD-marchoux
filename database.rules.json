{
  "rules": {
    // ─── DONNÉES PUBLIQUES (lecture pour tous, écriture admin seulement) ───
    "products": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ra@gmail.com'",
      ".indexOn": ["category", "name"]
    },
    
    "disciplines": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ra@gmail.com'"
    },
    
    // ─── ADMINS ───
    "admins": {
      ".read": "auth != null && auth.token.email === 'ra@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ra@gmail.com'",
      
      // Exemple : liste des UIDs admin
      // "abc123uid": true
    },
    
    // ─── UTILISATEURS ───
    "users": {
      "$uid": {
        // Chaque utilisateur peut lire/écrire son propre profil
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        
        // Validation des données utilisateur
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().matches(/^[^@]+@[^@]+\\.[^@]+$/)"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "isAdmin": {
          ".validate": false  // Seul le serveur peut définir ce champ
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    
    // ─── COMMANDES ───
    "orders": {
      ".read": "auth != null && auth.token.email === 'ra@gmail.com'",
      ".write": "auth != null",
      
      "$orderId": {
        ".validate": "newData.hasChildren(['userId', 'items', 'total', 'createdAt'])",
        
        "userId": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "items": {
          ".validate": "newData.hasChildren()"
        },
        "total": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(pending|confirmed|delivered|cancelled)$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "userName": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "userPhone": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        }
      }
    },
    
    // ─── PANIERS (optionnel - si tu veux sync panier) ───
    "carts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    
    // ─── NOTIFICATIONS / MESSAGES ───
    "messages": {
      ".read": "auth != null && auth.token.email === 'ra@gmail.com'",
      ".write": "auth != null",
      
      "$msgId": {
        ".validate": "newData.hasChildren(['from', 'text', 'createdAt'])",
        "from": {
          ".validate": "newData.val() === auth.uid"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    
    // ─── STATS / ANALYTICS ───
    "stats": {
      ".read": "auth != null && auth.token.email === 'ra@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ra@gmail.com'"
    },
    
    // ─── BLOQUER TOUT LE RESTE ───
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}